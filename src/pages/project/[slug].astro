---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categoryLabel } from '../../lib/categories';
import BeforeAfter from '../../components/BeforeAfter.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.published);

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const {
  title,
  description,
  category,
  year,
  coverImage,
  gallery,
  videos,
  video,
  beforeAfter,
} = project.data;

const comparisons = (beforeAfter ?? []).filter(
  (item) => item && item.before && item.after
);

const allVideos =
  videos?.length
    ? videos
    : video
      ? [video]
      : [];

const hasAnyVideo = allVideos.some(
  (item) =>
    (item.sourceType === 'upload' && item.file) ||
    (item.sourceType === 'external' && item.externalUrl)
);
---

<BaseLayout title={`${title} — Oksana`} description={description}>
  <main class="project-detail">

    <section class="project-detail-hero wrap">
      <a class="project-back" href={`/work/${category}/`}>
        ← {categoryLabel(category)}
      </a>

      <div class="project-detail-head">
        <p class="eyebrow">
          {year ? `${year} — ` : ''}{categoryLabel(category)}
        </p>

        <h1 class="project-detail-title">{title}</h1>

        <p class="project-detail-description">
          {description}
        </p>
      </div>

      {!hasAnyVideo && comparisons.length === 0 && (
        <figure class="project-cover">
          <img src={coverImage} alt={title} />
        </figure>
      )}
    </section>

    {comparisons.length > 0 && (
      <section class="project-compare wrap" aria-label={`${title} before and after`}>
        {comparisons.map((item) => (
          <BeforeAfter
            before={item.before!}
            after={item.after!}
            title={item.title ?? undefined}
            alt={title}
          />
        ))}
      </section>
    )}

    {gallery?.length > 0 && (
      <section
        class="project-gallery wrap"
        aria-label={`${title} gallery`}
      >
        {gallery.filter(Boolean).map((item, i) => {
          const imageSrc =
            typeof item === 'string' ? item : item.image;

          const imageTitle =
            typeof item === 'string' ? undefined : item.title;

          return (
            <figure
              class={`project-gallery-item ${
                i % 3 === 0 ? 'project-gallery-wide' : ''
              }`}
            >
              <img
                src={imageSrc}
                alt={imageTitle || `${title} — image ${i + 1}`}
                loading="lazy"
              />

              {imageTitle && (
                <figcaption>
                  {imageTitle}
                </figcaption>
              )}
            </figure>
          );
        })}
      </section>
    )}

    {hasAnyVideo && (
      <section class="project-video wrap">
        {allVideos.map((item) => (
          item.sourceType === 'upload' && item.file ? (
            <video
              controls
              playsinline
              preload="metadata"
              poster={item.poster || undefined}
            >
              <source src={item.file} />
            </video>
          ) : item.sourceType === 'external' && item.externalUrl ? (
            <video
              controls
              playsinline
              preload="metadata"
              poster={item.poster || undefined}
            >
              <source src={item.externalUrl} />
            </video>
          ) : null
        ))}
      </section>
    )}

  </main>
</BaseLayout>
