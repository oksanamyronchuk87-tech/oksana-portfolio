---
import type { CollectionEntry } from 'astro:content';
import { categoryLabel } from '../lib/categories';

interface Props {
  project: CollectionEntry<'projects'>;
  numberLabel: string;
  extraClass?: string;
  labelSub?: string;
  toneClass?: string;
}

const { project, numberLabel, extraClass = '', labelSub = 'Placeholder', toneClass = '' } = Astro.props;
const { title, coverImage, category, video} = project.data;
const hasUploadedVideo = video?.sourceType === 'upload' && video?.file;
const href = `/project/${project.slug}/`;
---
<a class={`work-item project-link ${extraClass}`} href={href} aria-label={`View ${title}`}>
  <div class={`plate ${toneClass}`}>
    {hasUploadedVideo ? (
      <video
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
      >
        <sourse src={video!.file} />
      </video>
     ) : (
      <img
        style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
        src={coverImage}
        alt={title}
        loading="lazy"
       />
     )}
    <div class="plate-label" style="display:none;">
      <div class="mark">Project Image</div>
      <div class="sub">{labelSub}</div>
    </div>
  </div>
  <div class="work-meta">
    <span class="num">{numberLabel}</span>
    <span class="title">{title}</span>
    <span class="cat">{categoryLabel(category)}</span>
  </div>
</a>
