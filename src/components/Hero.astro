---
interface Props {
  eyebrow: string;
  subtitle: string;
  showreel: { enabled: boolean; video?: string; poster?: string };
}
const { eyebrow, subtitle, showreel } = Astro.props;
const useVideo = showreel?.enabled && showreel?.video;
---
<section class="hero">
  <div class="hero-eyebrow-top">{eyebrow}</div>

  {useVideo ? (
    <div class="plate">
      <video
        class="plate-scale"
        style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover;"
        src={showreel.video}
        poster={showreel.poster}
        autoplay
        muted
        loop
        playsinline
      />
    </div>
  ) : (
    <div class="plate">
      <div class="plate-scale" style="position:absolute; inset:0;">
        <div class="plate-label">
          <div class="mark">Showreel</div>
          <div class="sub">Full portfolio reel — coming soon</div>
        </div>
      </div>
    </div>
  )}

  <div class="hero-content">
    <h1 class="hero-title">OKSANA<br>AI CREATIVE</h1>
    <div class="hero-sub">
      <p class="hero-tagline">{subtitle}</p>
      <a href="#work" class="hero-cta">
        <span class="ring">↓</span>
        View Work
      </a>
    </div>
  </div>
</section>
