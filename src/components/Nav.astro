---
interface Props {
  settings?: { name: string };
}
const { settings } = Astro.props;
const name = settings?.name ?? 'Oksana';
---
<header class="nav">
  <div class="nav-logo">{name.toUpperCase()}</div>
  <nav class="nav-links">
    <a href="/#work">Work</a>
    <a href="/#about">About</a>
    <a href="/#contact">Contact</a>
  </nav>
  <button class="nav-toggle" id="menuOpen" aria-label="Open menu">Menu</button>
</header>
